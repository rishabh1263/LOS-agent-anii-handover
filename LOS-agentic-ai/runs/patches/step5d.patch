+    co_applicants.record_intake(case_id, applicant_id, "COAPP-MEM000000001", {}, None, ready)
+    state = ConversationState(conversation_id="c1", subject_key=OWNER, case_id=case_id)
+    state.last_subject_party = "CO_APPLICANT"
