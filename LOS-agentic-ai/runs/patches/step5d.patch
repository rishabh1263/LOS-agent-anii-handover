+    assert [(r["case_id"], r["reason"]) for r in plan["remaps"]] == [(clash, "APPLICANT_ID_CONFLICT")]
+    assert [e["case_id"] for e in plan["excluded"]] == [evalcase] and plan["excluded"][0]["also_an_applicant_id"]
