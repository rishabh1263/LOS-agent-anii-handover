+    other, _ = make_case(ready)
+    wrong = asyncio.run(co_applicant_get(other, "COAPP-MCP000000001")).as_tool_payload()
+    assert wrong["ok"] is False and wrong["error"]["code"] == "CO_APPLICANT_NOT_FOUND"   # not on that case
