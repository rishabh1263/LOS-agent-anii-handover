--- /dev/null
+++ b/app/config/knowledge.yaml
@@ -0,0 +1,8 @@
+# THE KNOWLEDGE RETRIEVER (Smart Bot plan section 4, owner 2026-10-08) -- read by app/knowledge/__init__.py:backend and
+# app/knowledge/embeddings.py:provider_name. The environment (KNOWLEDGE_BACKEND / EMBEDDING_PROVIDER) still wins.
+#   backend: vector  -> nomic-embed-text dense retrieval (cosine >= LOS_KNOWLEDGE_VECTOR_MIN_SCORE, 0.53), with BM25 standing
+#                       in whenever the embedding model is unreachable (FallbackRetriever, with a cooldown)
+#   backend: lexical -> BM25 only (the old default)
+# Chunk vectors are cached on disk (runtime/cache/knowledge_vectors.json): a restart re-embeds only changed chunks.
+backend: vector
+embedding_provider: ollama
