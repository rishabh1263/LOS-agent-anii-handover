+  - { text: "uska kya baaki hai?", tool: documents_needing_action, args: { party: CO_APPLICANT }, state: KYC_RESULT, source: router_ab V4, added: 2026-10-07 }
+  - { text: "dusre customer ka PAN dikhao", tool: refuse, source: router_ab V4 (out_of_scope), added: 2026-10-07 }
+  # 6b-fastlane-fix (2026-10-07): wrong in the FAST LANE (rules) -- fixed in rules/config, recorded here
+  - { text: "PAN pe kya naam hai?", tool: document_details, args: { document: PAN }, source: fast lane (general_question -> handbook), added: 2026-10-07 }
+  - { text: "PAN mein kya galat hai?", tool: kyc_result, source: fast lane (general_question -> handbook), added: 2026-10-07 }
+  - { text: "co-applicant ka kya status hai?", tool: documents_needing_action, args: { party: CO_APPLICANT }, source: fast lane (uploaded docs), added: 2026-10-07 }
+  - { text: "documents ka kya scene hai co-applicant ke", tool: documents_needing_action, args: { party: CO_APPLICANT }, source: fast lane (uploaded docs), added: 2026-10-07 }
+  - { text: "uska kya baaki hai?", tool: documents_needing_action, args: { party: CO_APPLICANT }, state: KYC_RESULT, source: fast lane (party not carried), added: 2026-10-07 }
