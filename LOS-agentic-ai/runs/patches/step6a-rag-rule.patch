+def _states_threshold(canonical: str, groups: list[list[str]], hits) -> bool:
+    """
+    Whether a THRESHOLD question ("minimum", "cut-off", ...) has a passage that states one.
+
+    THE NUMBER MUST BE IN THE PASSAGE THAT ANSWERS. A digit anywhere in the top
+    three is not a stated threshold: "minimum CIBIL score for approval" came back
+    confident on a definition's "300 to 900" while the passage that covered the
+    question stated none (rag_036, 2026-10-07). The passage carrying the number
+    must itself cover what was asked -- as the rescued path requires of its top
+    passage. Any other question: True.
+    """
+    if not _asks_threshold(canonical):
+        return True
+    return any(
+        any(ch.isdigit() for ch in h.chunk.text)
+        and (len(groups) < 2 or (_group_coverage(groups, h)[0] >= _ACCEPT_COVERAGE
+                                 and _group_coverage(groups, h)[1] >= _MIN_MATCHED))
+        for h in hits)
+
