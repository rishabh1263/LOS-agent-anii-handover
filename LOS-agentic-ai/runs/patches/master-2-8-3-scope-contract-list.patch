+# THE CASE LIST AT SCALE (MASTER SPEC section 3) -- read by app/agents/applicant/copilot/capabilities/case_list.py
+# and the paginated list endpoint GET /api/v1/fos/cases. Scope is code (the caller's own grants, every row
+# re-checked); everything below is config.
+
+# flag COPILOT_CASE_LIST_PAGING (env) overrides; false = the earlier grouped list
+enabled: true
+page_size: 5         # one chat reply never shows more than one page
+max_page_size: 20
+cache_ttl_seconds: 30 # per user: the computed row statuses of their cases
+
+# the default order: needs action first (KYC issue, then documents pending, then in progress, then ready)
+default_sort: needs_action
+sorts:
+  needs_action: { order: [KYC, DOCS, OTHER, READY], then: recent }
+  recent: { by: updated_at, desc: true }
+  oldest: { by: created_at, desc: false }
+  longest_in_stage: { by: days_in_stage, desc: true }
+
+# filters: a row status kind (KYC / DOCS / READY / OTHER), "over target" (timeline), a stage, a product
+filters:
+  needs_action: { kinds: [KYC, DOCS] }
+  kyc_issue: { kinds: [KYC] }
+  documents_pending: { kinds: [DOCS] }
+  ready_for_cpa: { kinds: [READY] }
+  stuck: { over_target: true }
+
+# ---- natural language -> the query (matched as whole words, after the normaliser) ------------------------------
+phrases:
+  # "top 5", "pehle 3", "first 10": the first N in the default order
+  first_n: [top, pehle, pehla, first, shuru ke]
+  # "last 3", "latest 3", "recent cases": the newest N
+  last_n: [last, latest, recent, naye, naya, nayi, newest, haal ke]
+  # "sabse purane", "oldest"
+  oldest: [sabse purane, sabse purana, oldest, purane, purana, old cases]
+  longest_in_stage: [sabse zyada atke, longest in stage, sabse lambe]
+  # "aur dikhao", "next", "agle 5"
