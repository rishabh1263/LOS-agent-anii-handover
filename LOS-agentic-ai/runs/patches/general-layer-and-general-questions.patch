+    - ['^(.+?) kaun (?:karta|karti|deta|deti|decide karta|decide karti) hai$', 'who \1']
+    - ['^(.+?) aur (.+?) (?:mein|me|main) (?:kya )?(?:fark|farak|difference)(?: hai| kya hai)?$', 'difference between \1 and \2']
+    - ['^(.+?) (?:mein|me) (?:kya|kya kya) (?:chalega|chalta hai|chalti hai)$', 'which documents are accepted as \1']
