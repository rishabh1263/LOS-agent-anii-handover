+# GENERAL QUESTIONS a loan field officer (FOS) asks -- the coverage bank (2026-10-08).
+# Built from research (lender / RBI KYC / LAP-process pages) + this LOS's own config. Every question here must be
+# answered WITH NO CASE OPEN: never "Which case is this about?", never "I don't know" for something the system knows.
+#
+#   expect: answer        -- a real answer (glossary / knowledge / config / calculator)
+#           not_configured -- a company number that is not in config: say so + who decides (never a guessed number)
+#           decline       -- a credit decision the bot must not make: say who decides
+#           unknown       -- deliberately not in the knowledge base (said plainly, logged)
+#           case          -- needs a case: "which case?" is the RIGHT answer
+#
+# tests/integration/test_general_coverage.py runs every question and reports the coverage per category.
+
+categories:
+  terms:
+    - { q: "what is FOIR", expect: answer }
+    - { q: "FOIR kya hai", expect: answer }
+    - { q: "what is LTV", expect: answer }
+    - { q: "LTV ka matlab", expect: answer }
+    - { q: "what is EMI", expect: answer }
+    - { q: "what is CIBIL score", expect: answer }
+    - { q: "cibil score kya hota hai", expect: answer }
+    - { q: "what is KYC", expect: answer }
+    - { q: "what is OVD", expect: unknown }   # owner 2026-10-07: OVD left out of the glossary on purpose
+    - { q: "what is CKYC", expect: answer, must: ["registry"] }
+    - { q: "what is video KYC", expect: answer, must: ["video call"] }
+    - { q: "what is NACH", expect: answer, must: ["mandate"] }
+    - { q: "what is e-mandate", expect: answer, must: ["mandate"] }
+    - { q: "what is a co-applicant", expect: answer, must: ["together"] }
+    - { q: "what is a guarantor", expect: answer, must: ["not a borrower"] }
+    - { q: "difference between co-applicant and guarantor", expect: answer, must: ["guarantor", "co-applicant"] }
