+  # ... and name NO case: these words mean "this case / this customer" (the case logic answers those)
+  case_referents: [this case, is case, iss case, the case, my case, mera case, meri case, this customer, is customer,
+                   this loan, is loan, iska, iski, iske, uska, uski, uske, inka, unka, his, her, their, this file,
