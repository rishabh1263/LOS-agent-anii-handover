+    s = _AMOUNT.sub(lambda m: _say_amount(m.group(1), lang), s)
+    s = _ID.sub(lambda m: _say_id(m, lang), s)
+    for symbol, word in (((_tts_cfg().get("symbols") or {}).get(lang)) or {}).items():
+        s = s.replace(symbol, word)
