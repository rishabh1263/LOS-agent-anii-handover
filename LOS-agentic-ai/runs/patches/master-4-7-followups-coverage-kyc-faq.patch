+    s = re.sub(r"(?<=\w)-(?=\w)", "-", s)
+    s = re.sub(r"\s-\s|^\s*-\s*", " ", s)
+    s = re.sub(r"\s+([,.;:!?।])", r"\1", " ".join(s.split()))
+    return s.strip(" ,;")
+
+
+def _sentence(text: str) -> str:
