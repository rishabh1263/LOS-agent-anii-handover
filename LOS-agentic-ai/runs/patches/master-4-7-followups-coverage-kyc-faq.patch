+_DATE = re.compile(r"\b(\d{4})-(\d{2})-(\d{2})(?:[T ][\d:.]+(?:Z|[+-]\d\d:?\d\d)?)?\b")
+_STATUS = re.compile(r"\*\*([A-Z_]{3,})\*\*")
