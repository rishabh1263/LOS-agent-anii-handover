+# ---- the chat follow-up after a case-portfolio answer (15.2 step 4) --------------------------------------------
+portfolio_flow:
+  enabled: true
+  # quoted: bare yes / no / y / n / ok are booleans in YAML
+  yes_words: ["yes", "y", "haan", "ha", "han", "haa", "ji", "ji haan", "yes please", "sure", "ok", "okay", "theek hai",
+              "bilkul", "हाँ", "हां", "हो", "होय"]
+  no_words: ["no", "n", "nahi", "nahin", "na", "nope", "no thanks", "rehne do", "नहीं", "नाही", "नको"]
+  pending_words: [pending, pending wale, pending cases, baaki, lambit, लंबित, प्रलंबित]
+  done_words: [done, done wale, done cases, complete, completed, pure, ho gaye, पूरे, पूर्ण]
+  texts:
+    ask_particular:
+      en: ["Do you want to know about a particular case?", "Would you like details of a particular case?"]
