+    tenure_months: { en: "Tenure (months)", hi-Latn: "Tenure (mahine)", hi: "अवधि (महीने)", mr: "मुदत (महिने)" }
+    interest_rate_pct: { en: "Interest rate (%)", hi-Latn: "Interest rate (%)", hi: "ब्याज दर (%)", mr: "व्याज दर (%)" }
