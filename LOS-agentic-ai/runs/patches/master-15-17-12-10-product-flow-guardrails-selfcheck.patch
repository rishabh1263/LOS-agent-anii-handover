+# THE APPROVED PRODUCT FLOW (MASTER SPEC section 15 / 15.5) -- one file for the officer-facing words, mappings and
+# limits of: the case statuses (Created / Review / Disbursal -> Pending / Done), the home table, the chat follow-up
+# ("Do you want to know about a particular case?"), the quick buttons, downloads, case creation / editing from
+# chat, Excel import, chat history, the activity log and notifications.
+#
+# Read by app/agents/applicant/copilot/capabilities/product_flow.py (and exports.py, case_form.py, importer.py).
+# Scope, confirmation before every write, and the reply contract are CODE and never configurable (section 14).
+# Every text: en, hi-Latn, hi, mr. A list = variants (picked per turn).
+
+# ---- statuses (15.5) -------------------------------------------------------------------------------------------
+# The real data has stages (app/config/stage_lifecycle.yaml). Each stage maps to ONE business status; each
+# status belongs to ONE group. The home table, chat lists, filters, counts and the Pending/Done follow-up all
+# use this mapping. A stage not listed here maps to `default_status`.
+case_status:
+  by_stage:
+    FOS: Created
+    CPA: Review
+    CREDIT: Review
+    RCU: Review
+    BOPS: Review
+    HOPS: Review
+    DISBURSEMENT: Disbursal
+  default_status: Created
+  groups:
+    pending: [Created, Review]
+    done: [Disbursal]
+  labels:
+    Created: { en: "Created", hi-Latn: "Created", hi: "बनाया गया", mr: "तयार केले" }
+    Review: { en: "Review", hi-Latn: "Review", hi: "समीक्षा", mr: "पुनरावलोकन" }
+    Disbursal: { en: "Disbursal", hi-Latn: "Disbursal", hi: "वितरण", mr: "वितरण" }
+  group_labels:
+    pending: { en: "Pending", hi-Latn: "Pending", hi: "लंबित", mr: "प्रलंबित" }
+    done: { en: "Done", hi-Latn: "Done", hi: "पूरे", mr: "पूर्ण" }
+  # chat phrases for a status / group filter (whole phrases, after the normaliser; longest first). Bare
+  # "pending" / "done" count only as the answer to "Pending or Done?" (portfolio_flow), never on their own.
+  phrases:
+    group:
+      pending: [my pending cases, pending cases, pending case, pending wale cases, pending wale, pending wala,
