+    declared_monthly_income: { number: true }
+    declared_monthly_obligations: { number: true }
+    property_value: { number: true }
+  choices:
+    employment_type: [SALARIED, SELF_EMPLOYED]
+  labels:
+    full_name: { en: "Applicant name", hi-Latn: "Applicant ka naam", hi: "आवेदक का नाम", mr: "अर्जदाराचे नाव" }
+    mobile: { en: "Mobile", hi-Latn: "Mobile", hi: "मोबाइल", mr: "मोबाईल" }
