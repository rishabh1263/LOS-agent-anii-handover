+    needs_action: { en: "needs action", hi-Latn: "kaam baaki", hi: "कार्रवाई ज़रूरी", mr: "कारवाई आवश्यक" }
+    search: { en: "search: {q}", hi-Latn: "search: {q}", hi: "खोज: {q}", mr: "शोध: {q}" }
+  sorted:
+    needs_action: { en: "needs action first", hi-Latn: "pehle jinme kaam hai", hi: "पहले जिनमें काम है",
+                    mr: "आधी ज्यांत काम आहे" }
+    recent: { en: "newest first", hi-Latn: "naye pehle", hi: "नए पहले", mr: "नवीन आधी" }
+    oldest: { en: "oldest first", hi-Latn: "purane pehle", hi: "पुराने पहले", mr: "जुने आधी" }
+    longest_in_stage: { en: "longest in stage first", hi-Latn: "sabse lambe atke pehle", hi: "सबसे लंबे अटके पहले",
+                        mr: "सर्वात जास्त काळ अडकलेले आधी" }
+  showing:
+    en: "Showing {first}-{last} of {total} ({sort})."
+    hi-Latn: "{total} mein se {first}-{last} dikha rahe hain ({sort})."
+    hi: "{total} में से {first}-{last} दिखा रहे हैं ({sort})।"
+    mr: "{total} पैकी {first}-{last} दाखवत आहोत ({sort})."
+  none:
+    en: ["You have no cases you can open.", "There are no cases under you yet."]
+    hi-Latn: ["Aapke paas abhi koi case nahi hai.", "Abhi aapke under koi case nahi hai."]
+    hi: ["आपके पास अभी कोई केस नहीं है।"]
+    mr: ["तुमच्याकडे अजून कोणतीही केस नाही."]
+  none_match:
+    en: "None of your cases match ({filter})."
+    hi-Latn: "Aapka koi case match nahi karta ({filter})."
+    hi: "आपका कोई केस मेल नहीं खाता ({filter})।"
+    mr: "तुमची कोणतीही केस जुळत नाही ({filter})."
+  end:
+    en: "That is the whole list."
+    hi-Latn: "Bas, list yahin tak hai."
+    hi: "सूची यहीं तक है।"
+    mr: "यादी इथेच संपते."
+  follow_up:
+    en: ["Open one, or ask: show more, KYC issues, ready for CPA, oldest.",
+         "Pick a case to open, or say show more / KYC issues / ready for CPA."]
+    hi-Latn: ["Ek case kholiye, ya boliye: aur dikhao, KYC wale, ready wale, sabse purane.",
+              "Case kholne ke liye chuniye, ya boliye aur dikhao / KYC wale / ready wale."]
+    hi: ["कोई केस खोलें, या कहें: और दिखाओ, KYC वाले, तैयार वाले, सबसे पुराने।"]
+    mr: ["एक केस उघडा, किंवा म्हणा: आणखी दाखवा, KYC वाले, तयार, सर्वात जुने."]
+  # the options under the list (ask: links)
+  options:
+    en: ["Show more", "KYC issues", "Ready for CPA", "Oldest cases"]
+    hi-Latn: ["Aur dikhao", "KYC wale", "Ready wale", "Sabse purane"]
