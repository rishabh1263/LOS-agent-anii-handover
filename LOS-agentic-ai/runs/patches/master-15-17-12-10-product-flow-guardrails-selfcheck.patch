+# THE CASE LIST AT SCALE (MASTER SPEC section 3) -- read by app/agents/applicant/copilot/capabilities/case_list.py
+# and the paginated list endpoint GET /api/v1/fos/cases. Scope is code (the caller's own grants, every row
+# re-checked); everything below is config.
+
+# flag COPILOT_CASE_LIST_PAGING (env) overrides; false = the earlier grouped list
+enabled: true
+page_size: 5         # one chat reply never shows more than one page
+max_page_size: 20
+cache_ttl_seconds: 30 # per user: the computed row statuses of their cases
+
+# the default order: needs action first (KYC issue, then documents pending, then in progress, then ready)
+default_sort: needs_action
+sorts:
+  needs_action: { order: [KYC, DOCS, OTHER, READY], then: recent }
+  recent: { by: updated_at, desc: true }
+  oldest: { by: created_at, desc: false }
+  longest_in_stage: { by: days_in_stage, desc: true }
+
+# filters: a row status kind (KYC / DOCS / READY / OTHER), "over target" (timeline), a stage, a product
+filters:
+  needs_action: { kinds: [KYC, DOCS] }
+  kyc_issue: { kinds: [KYC] }
+  documents_pending: { kinds: [DOCS] }
+  ready_for_cpa: { kinds: [READY] }
+  stuck: { over_target: true }
+
+# ---- section 17.2: a list request naming OTHER people is refused (never answered with anyone's list); "saare
+# cases" / "list all case" without them is the caller's own list (scoped by the grants, section 2) ---------------
+other_people: [other officers, other officer, all officers, all the officers, other users, all users, everyone,
+               everybody, other people, other employees, officer b, dusre logon, dusre officers, dusron ke,
+               doosron ke, sab logon, saare officers, sabhi officers, kisi aur ke, kisi aur ka, baaki officers,
+               दूसरे लोगों, सभी अधिकारियों, इतर अधिकारी]
+# ---- natural language -> the query (matched as whole words, after the normaliser) ------------------------------
+phrases:
+  # "top 5", "pehle 3", "first 10": the first N in the default order
+  first_n: [top, pehle, pehla, first, shuru ke]
+  # "last 3", "latest 3", "recent cases": the newest N
+  last_n: [last, latest, recent, naye, naya, nayi, newest, haal ke]
+  # "sabse purane", "oldest"
+  oldest: [sabse purane, sabse purana, oldest, purane, purana, old cases]
+  longest_in_stage: [sabse zyada atke, longest in stage, sabse lambe]
+  # "aur dikhao", "next", "agle 5"
+  next: [aur dikhao, next, agle, agla, aage, more, show more, aur]
+  filter:
+    kyc_issue: [kyc wale, kyc wala, kyc issue, kyc fail, kyc problem, kyc atka, kyc pending wale]
+    ready_for_cpa: [ready wale, ready wala, cpa ready, ready for cpa, taiyar wale, ready cases]
+    stuck: [atke hue, atka hua, atke, stuck, over target, late wale, der wale]
+    documents_pending: [pending docs wale, docs pending, documents pending, document pending wale, docs baaki,
+                        pending documents wale, docs wale]
+    needs_action: [action wale, needs action, kaam wale, jinme kaam hai]
+  # a number said as a word
+  numbers: { ek: 1, one: 1, do: 2, two: 2, teen: 3, three: 3, char: 4, chaar: 4, four: 4, paanch: 5, panch: 5,
+             five: 5, chhe: 6, six: 6, saat: 7, seven: 7, aath: 8, eight: 8, nau: 9, nine: 9, das: 10, ten: 10 }
+
+# ---- the words of the reply (per language; 2-4 variants where a line is said often) ---------------------------
+labels:
+  summary:
+    en: ["You have {total} cases: {parts}.", "{total} cases in all: {parts}."]
