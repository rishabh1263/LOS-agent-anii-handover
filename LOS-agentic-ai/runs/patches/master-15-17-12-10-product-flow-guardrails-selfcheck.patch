+# ---- case creation and editing from chat (15.5): the SAME fields and rules as the UI form ------------------------
+# The field list, types and max lengths come from the create-case request schema (CreateCaseRequest); the order,
+# questions, required set and format rules below are shared by the UI create / edit routes and the chat.
+case_form:
+  chat_create: true                  # 15.5: chat case creation ON (env COPILOT_CHAT_CASE_CREATE overrides)
+  draft_ttl_seconds: 1800            # an unconfirmed draft is dropped after this
+  required: [full_name, mobile, date_of_birth, address, product, loan_amount]
+  order: [full_name, mobile, date_of_birth, address, email, product, loan_amount, employment_type, tenure_months,
+          interest_rate_pct, declared_monthly_income, declared_monthly_obligations, property_value]
+  formats:
+    mobile: { pattern: "^[6-9]\\d{9}$", strip: "[\\s+-]|^91(?=\\d{10}$)" }
+    email: { pattern: "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
+    date_of_birth: { date: true, min_age: 18, max_age: 80 }
+    full_name: { pattern: "^[A-Za-z\\u0900-\\u097F .'-]{2,}$" }
+    tenure_months: { integer: true, min: 1, max: 480 }
+    interest_rate_pct: { number: true, min: 1, max: 60 }
