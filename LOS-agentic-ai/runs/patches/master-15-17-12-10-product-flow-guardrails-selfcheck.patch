+    yes_label: { en: "Yes", hi-Latn: "Haan", hi: "हाँ", mr: "हो" }
+    no_label: { en: "No", hi-Latn: "Nahi", hi: "नहीं", mr: "नाही" }
+    ask_group:
+      en: ["Pending or Done?", "Which ones -- Pending or Done?"]
+      hi-Latn: ["Pending ya Done?", "Kaunse -- Pending ya Done?"]
+      hi: ["लंबित या पूरे?"]
+      mr: ["प्रलंबित की पूर्ण?"]
+    no_reply:
+      en: ["Okay. Ask me anything about your cases.", "Sure. What else can I help with?"]
+      hi-Latn: ["Theek hai. Apne cases ke baare mein kuch bhi poochhiye.", "Theek hai. Aur kya madad karoon?"]
+      hi: ["ठीक है। अपने केस के बारे में कुछ भी पूछिए।"]
+      mr: ["ठीक आहे. तुमच्या केसबद्दल काहीही विचारा."]
+    pick:
+      en: "Pick a case from the list (tap Open, or type its number)."
+      hi-Latn: "List mein se ek case chuniye (Open dabaiye, ya number likhiye)."
+      hi: "सूची में से एक केस चुनें (Open दबाएँ या नंबर लिखें)।"
+      mr: "यादीतून एक केस निवडा (Open दाबा किंवा क्रमांक लिहा)."
+    what_to_know:
+      en: ["What do you want to know?", "What would you like to know about this case?"]
+      hi-Latn: ["Aap kya jaanna chahte hain?", "Is case ke baare mein kya jaanna hai?"]
+      hi: ["आप क्या जानना चाहते हैं?"]
+      mr: ["तुम्हाला काय जाणून घ्यायचे आहे?"]
+  # the options after a case opens from the flow (label = the question sent)
+  what_options:
+    en: ["What is the status?", "What is pending?", "Show the documents", "What is the KYC status?",
+         "Is it ready for CPA?"]
+    hi-Latn: ["Status kya hai?", "Kya pending hai?", "Documents dikhao", "KYC status kya hai?",
+              "Kya CPA ke liye ready hai?"]
+    hi: ["स्थिति क्या है?", "क्या बाकी है?", "दस्तावेज़ दिखाओ", "KYC की स्थिति क्या है?", "क्या CPA के लिए तैयार है?"]
