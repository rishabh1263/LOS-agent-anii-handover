# Credit Document Policy Agent -- every setting is optional; the defaults are shown.

# where the Credit document policies (*.credit.json) live
# DOCS_CREDIT_POLICY_DIR=app/agents/docs_verify_credit_agent/policies

# a SAMPLE policy may decide only when this is true; default: true in development/dev/local/test, false elsewhere
# DOCS_CREDIT_ALLOW_SAMPLE_POLICY=

# an evaluation whose audit record cannot be written is an error (503), never a result
# DOCS_CREDIT_REQUIRE_AUDIT=true

# the evaluation's deadline in seconds (504 when passed)
# DOCS_CREDIT_TIMEOUT_SECONDS=10

# the scopes that may call the API (space separated); the service write scope is also accepted
# DOCS_CREDIT_SCOPES=los.credit.underwrite

# the LOS stage whose policy is evaluated and at which underwriting may start
# DOCS_CREDIT_STAGE=CREDIT
