# =============================================================================
# LOS Agentic AI -- example configuration
#
#     cp .env.example .env        (Windows: copy .env.example .env)
#
# PLACEHOLDERS ONLY. No token, password, key or customer data belongs in this
# file or in the .env you derive from it. Real secrets come from your secret
# manager or the deployment environment, and .env must never be committed.
#
# Every variable listed here is one the code actually reads. Where a value is
# only a default, that is stated rather than implied.
# =============================================================================


# ── Service ──────────────────────────────────────────────────────────────────
AGENTIC_HOST=0.0.0.0
AGENTIC_PORT=8010

# development | staging | production
# production additionally refuses to start on an unsigned risk policy.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ── Authentication (REQUIRED -- the service refuses to start without these) ───
#
# The service is a RESOURCE SERVER. It validates short-lived RS256 access
# tokens against your identity provider's JWKS endpoint. It never holds a
# signing key, never issues a token and never stores one.
#
# Point JWT_JWKS_URL at YOUR identity provider. The value below is the local
# development provider (auth_provider_dev.py) and is not a production URL.
JWT_JWKS_URL=http://127.0.0.1:8020/.well-known/jwks.json
JWT_ISSUER=los-local
JWT_AUDIENCE=los-agentic-ai

# RS256 | RS384 | RS512 | ES256 | ES384 | ES512. Asymmetric only -- HS256 and
# `none` are rejected, so a leaked verification key cannot mint tokens.
JWT_ALGORITHM=RS256

# Clock-skew tolerance, seconds.
JWT_LEEWAY_SECONDS=30

# How long a fetched JWKS is cached, seconds. Minimum 30.
JWT_JWKS_CACHE_SECONDS=300


# ── LLM summary (OPTIONAL -- writes the summary sentence, decides NOTHING) ────
#
# The model runs LAST, after classification, verification, extraction, KYC,
# the decision and next_action are all final. It is shown statuses and counts
# only -- never an extracted PAN, name or date of birth. If it is off, slow,
# unreachable or its sentence fails validation, the deterministic summary is
# returned and `summary_source` is "deterministic". Nothing else changes.
#
# Ollama is a SEPARATE SERVICE, not a Python dependency:
#     ollama pull qwen2.5:3b
OLLAMA_HOST=http://127.0.0.1:11434

# Use a small NON-REASONING model. A reasoning model (qwen3, deepseek-r1)
# emits a thinking block before answering and cannot meet the budget.
OLLAMA_MODEL=qwen2.5:3b

# Fast-fail budget for one summary sentence, seconds. NOT a generation
# allowance -- overrunning costs only the sentence.
LOS_LLM_SUMMARY_TIMEOUT_SECONDS=1.5

# Hard ceiling on generated length. Bounds the work rather than the patience.
LOS_LLM_SUMMARY_MAX_TOKENS=64

# How long Ollama holds the model in memory after a call. Ollama's own
# default is 5 minutes; loading qwen2.5:3b back was measured at 2281 ms, which
# overruns the budget on its own and then suppresses the model for the whole
# cooldown. "0" restores Ollama's default unload behaviour, "-1" holds it
# indefinitely. Costs roughly 2 GB resident while it lasts.
LOS_LLM_KEEP_ALIVE=30m

# TCP connect probe before generating, seconds. Bounds the "provider is not
# running" case in milliseconds instead of paying the full timeout.
LLM_CONNECT_TIMEOUT_SECONDS=0.5

# Provider NOT LISTENING -> skip it for this many seconds, so a ten-document
# application does not pay ten probes.
LLM_UNAVAILABLE_COOLDOWN_SECONDS=60

# Provider ANSWERED, only too slowly -> a much shorter hold-off. These are
# deliberately different numbers: a refused connection means the provider is
# gone, while an overrun means it is up and was a little late. Measured, one
# request overran by 3 ms and the 60-second window then suppressed the model
# on the next FIFTEEN requests. Set to 0 to attempt the model every time.
LLM_SLOW_COOLDOWN_SECONDS=2

# How long a SUCCESSFUL probe is trusted before re-probing, seconds.
LLM_AVAILABLE_CACHE_SECONDS=5


# ── Storage and upload limits ────────────────────────────────────────────────
# Scratch directory for staged uploads. Must be writable; files are unlinked
# after processing.
AGENT_UPLOAD_ROOT=./runtime/uploads

# Per-file limit for /api/v1/extract-document ONLY.
#
# POST /api/v1/los/process does NOT read this variable: its limit is the
# constant MAX_UPLOAD_BYTES in app/agents/document_agent/workflow.py, fixed at
# 25 MB per file, with at most 10 files per application.
MAX_UPLOAD_BYTES=26214400


# ── OCR ──────────────────────────────────────────────────────────────────────
# Requires the rapidocr-onnxruntime package (see requirements.txt).
DOCUMENT_OCR_ENGINE=rapidocr

# Longest image side fed to the recogniser, pixels.
DOCUMENT_OCR_MAX_SIDE=1024

# Upscale images smaller than this before recognition. 0 disables.
DOCUMENT_OCR_UPSCALE_BELOW=0

# Load every OCR worker's model at startup. Leave on: with it off the first
# request pays roughly 2.3s of engine and ONNX session construction.
DOCUMENT_OCR_WARMUP=true

# Recovers word spacing inside names via a targeted Tesseract pass. Without it
# names come back as LAXMISANTOSHGUPTA rather than LAXMI SANTOSH GUPTA.
# REQUIRES THE TESSERACT BINARY -- pip does not install it. Missing Tesseract
# degrades (unspaced names); it does not crash.
DOCUMENT_NAME_SPACING=true

# One OCR model is held PER WORKER. Raising this costs memory, not just CPU.
# Commented -> 2 (capped at the CPU count).
#
# DO NOT set this to 1 to "avoid contention". Recognition then serialises and
# documents queue: measured at 29316 ms for four documents against 3525 ms
# with two workers.
# DOCUMENT_OCR_WORKERS=2

# ONNX intra-op threads PER ENGINE. Commented -> (logical CPUs / 2) / workers,
# which is 4 on a 16-logical-CPU host running 2 workers.
#
# This used to be unbounded, and unbounded is the wrong default: ONNX sizes
# the pool from the core count PER SESSION, so two workers asked for two
# machines' worth of threads and spent the difference on contention. Measured
# end to end on the reference host (10 physical / 16 logical cores), median
# processing_ms with the summary model off:
#
#     intra-op threads   1 doc    2 docs   4 docs
#     unbounded (old)     1577      2438     5002
#     4 (new default)      925      1754     2814
#
# An older comment here reported DOCUMENT_OCR_THREADS=4 as catastrophic
# (13053 ms) on a different 16-core host. That is not what this hardware
# does, which is the point: benchmark before overriding. Set 0 to restore the
# old unbounded behaviour.
# DOCUMENT_OCR_THREADS=4

# Library-level thread caps (OMP/MKL/OpenBLAS), applied in main.py before
# numpy/OpenCV/ONNX are imported. Separate from the setting above and still
# best left alone: DOCUMENT_OCR_LIB_THREADS=1 was worse than not setting it.
# DOCUMENT_OCR_LIB_THREADS=1


# ── Document processing ──────────────────────────────────────────────────────
# All commented -> code defaults. Set only after measuring on the target host.
# DOCUMENT_WORKERS=
# DOCUMENT_RENDER_WORKERS=
# DOCUMENT_MAX_PDF_PAGES=
# DOCUMENT_PDF_DPI=
# DOCUMENT_AGENT_ESCALATION=

DOCUMENT_AGENT_ENABLED=true
DOCUMENT_AGENT_VERSION=1.0.0


# ── Verification gate ────────────────────────────────────────────────────────
# Global switch first, then per-document overrides of the form
# VERIFICATION_ENABLED_<DOCUMENT_TYPE>. A bypass is always reported in the
# response as status=SKIPPED, never applied silently -- and SKIPPED withholds
# extraction rather than releasing it.
VERIFICATION_ENABLED=true
VERIFICATION_ENABLED_PAN=true
VERIFICATION_ENABLED_DRIVING_LICENCE=true
VERIFICATION_ENABLED_VOTER_ID=true
VERIFICATION_ENABLED_PASSPORT=true
VERIFICATION_ENABLED_ITR=true
VERIFICATION_ENABLED_FINANCIAL=true
VERIFICATION_ENABLED_SALE_DEED=true

# Minimum confidence a field must reach to count as verified.
# Commented -> code default.
# VERIFY_MIN_CONFIDENCE=


# ── LOS stage flags ──────────────────────────────────────────────────────────
# Defaults live in app/config/documents.yaml under `los:`. Each is overridable
# here as LOS_<NAME>. Environment wins over YAML.
#
# OFF MEANS OFF AND IS REPORTED: a disabled stage does not silently behave as
# enabled -- the response carries SKIPPED plus a reason code.
#
# LOS_CLASSIFICATION_ENABLED=true
# LOS_VERIFICATION_ENABLED=true
# LOS_EXTRACTION_ENABLED=true
# LOS_FINANCIAL_ENABLED=true
# LOS_KYC_ENABLED=true
# LOS_CONFLICT_DETECTION_ENABLED=true
# LOS_SIGNATURE_ENABLED=true
# LOS_BUSINESS_EVIDENCE_ENABLED=true
# LOS_SALE_DEED_ENABLED=true
# LOS_LLM_SUMMARY_ENABLED=true
#
# Off by default: no contract exists for the external service.
# LOS_COLLATERAL_CUSTOMER_ENABLED=false
# LOS_COLLATERAL_PROPERTY_ENABLED=false


# ── KYC ──────────────────────────────────────────────────────────────────────
KYC_AGENT_ENABLED=true
KYC_AGENT_VERSION=1.0.0
# Commented -> app/config/kyc_policies.yaml
# KYC_POLICY_PATH=


# ── Bank statement ───────────────────────────────────────────────────────────
BANK_STATEMENT_MAX_PAGES=150

# A 50-page digital statement takes ~20s to read table cells. A smaller budget
# truncates it mid-parse and returns PARTIAL.
BANK_STATEMENT_TIME_BUDGET_MS=60000

# Scanned statements up to this many pages are OCR'd inline; longer ones
# return REQUIRES_OCR with HTTP 202 for the asynchronous queue.
BANK_STATEMENT_INLINE_OCR_PAGES=4


# ── ITR ──────────────────────────────────────────────────────────────────────
# A digital ITR-V parses from its text layer in under 300ms, no OCR.
ITR_OCR_ENABLED=true
ITR_MAX_OCR_PAGES=3


# ── Specialist capabilities ──────────────────────────────────────────────────
SALE_DEED_HINDI_OCR=true
# SALE_DEED_MAX_PAGES=
# BUSINESS_EVIDENCE_OVERLAY_OCR=


# ── Orientation detection ────────────────────────────────────────────────────
# All commented -> code defaults.
# ORIENTATION_MIN_CONFIDENCE=
# ORIENTATION_MIN_IMAGE_SIZE=
# ORIENTATION_ANALYSIS_MAX_SIDE=
# SURYA_ORIENTATION_FALLBACK=


# ── Fraud & risk agent ───────────────────────────────────────────────────────
FRAUD_RISK_AGENT_ENABLED=true
FRAUD_RISK_AGENT_VERSION=1.0.0
FRAUD_RISK_LLM_SUMMARY_ENABLED=true
FRAUD_RISK_LLM_TIMEOUT_SECONDS=20
FRAUD_RISK_AUDIT_ENABLED=true
FRAUD_RISK_AUDIT_PATH=./runtime/audit/risk_decisions.jsonl

# Risk thresholds are NOT signed off. The service refuses to start with
# ENVIRONMENT=production until credit approves them. Do not set this to true
# to get past that -- get the policy signed.
ALLOW_UNSIGNED_RISK_POLICY=false


# ── Orchestrator resilience ──────────────────────────────────────────────────
ORCHESTRATOR_RETRY_ENABLED=true
ORCHESTRATOR_BREAKER_ENABLED=true
ORCHESTRATOR_BREAKER_THRESHOLD=5
ORCHESTRATOR_BREAKER_RESET_SECONDS=30
ORCHESTRATOR_BULKHEAD_ENABLED=true
ORCHESTRATOR_MAX_CONCURRENCY=10


# ── Configuration file paths ─────────────────────────────────────────────────
# All commented -> the bundled files under app/config/.
# AGENTS_CONFIG_PATH=
# DOCUMENTS_CONFIG_PATH=
# RISK_POLICY_PATH=


# ── Observability ────────────────────────────────────────────────────────────
# Flag only. There is no exporter or span in this codebase; enabling it does
# not currently emit traces.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=los-agentic-ai




JWT_ALGORITHM=RS256
JWT_ISSUER=los-local
JWT_AUDIENCE=los-agentic-ai
JWT_JWKS_URL=http://127.0.0.1:8010/.well-known/jwks.json
JWT_LEEWAY_SECONDS=30
JWT_JWKS_CACHE_SECONDS=300
DUMMY_USERNAME=AniketDev
DUMMY_PASSWORD_HASH=pbkdf2_sha256$260000$a05093757b6261cd2e510137f1804ec4$3e1c2c69844e117a0b66c7a4c324b217df0450f8ea9226c2579ffe673e68a1f8

# password Dev@123

# ============================================================
# Poppler
# ============================================================

POPPLER_PATH=D:\Application Download\poppler-26.09.0\Library\bin
# ---------------------------------------------------------------------------
# LOS case store and the FOS applicant agent
# ---------------------------------------------------------------------------
LOS_STORE_BACKEND=sqlite
LOS_STORE_PATH=runtime/los_store.sqlite3

APPLICANT_AGENT_ENABLED=true
APPLICANT_AGENT_ENFORCE=true
APPLICANT_AGENT_LLM_ENABLED=true
APPLICANT_AGENT_LLM_FOR_SIMPLE_INTENTS=false
APPLICANT_AGENT_AUDIT_ENABLED=true
APPLICANT_AGENT_AUDIT_PATH=runtime/audit/applicant_agent.jsonl
