          <mxGeometry x="340" y="112" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="&lt;b&gt;Internal LOS User&lt;/b&gt;&lt;br&gt;Credit · RCU · Operations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6F82;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="610" y="112" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ch1" value="&lt;b&gt;FOS UI&lt;/b&gt; (React + TypeScript)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#2E5E9E;fontSize=11;fontColor=#12304F;" vertex="1" parent="1">
          <mxGeometry x="960" y="112" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ch2" value="&lt;b&gt;LOS UI&lt;/b&gt; (React + TypeScript)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#2E5E9E;fontSize=11;fontColor=#12304F;" vertex="1" parent="1">
          <mxGeometry x="1270" y="112" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ch3" value="&lt;b&gt;LOS AI Chatbot&lt;/b&gt; (Web / Mobile)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#2E5E9E;fontSize=11;fontColor=#12304F;" vertex="1" parent="1">
          <mxGeometry x="1580" y="112" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="u2c" value="enter through →" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#5A6C7D;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="866" y="112" width="90" height="50" as="geometry" />
        </mxCell>

        <!-- ================= BAND 2 : SECURITY ================= -->
        <mxCell id="s1" value="&lt;b&gt;Authentication&lt;/b&gt;&lt;br&gt;(OAuth 2.0 + OIDC, RS256 JWT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B3392B;fontSize=11;fontColor=#5A1810;" vertex="1" parent="1">
          <mxGeometry x="70" y="240" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Authorization&lt;/b&gt;&lt;br&gt;(RBAC — roles, scopes, case &amp; party ownership)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B3392B;fontSize=11;fontColor=#5A1810;" vertex="1" parent="1">
          <mxGeometry x="420" y="240" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;(Kong / NGINX — TLS 1.3, rate limiting, WAF)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B3392B;fontSize=11;fontColor=#5A1810;" vertex="1" parent="1">
          <mxGeometry x="820" y="240" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Enforced on every request:&lt;/b&gt;  identity · token signature &amp; expiry · role / scope · case ownership · applicant &amp; co-applicant ownership · agent &amp; service authorisation · audit log entry.&amp;nbsp;&amp;nbsp;&lt;b&gt;Secrets never leave the vault&lt;/b&gt; (HashiCorp Vault)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D9BE5E;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#4A4020;" vertex="1" parent="1">
          <mxGeometry x="1220" y="240" width="680" height="50" as="geometry" />
        </mxCell>

        <!-- ================= BAND 3 : API / ORCHESTRATION ================= -->
        <mxCell id="api" value="&lt;b&gt;LOS API&lt;/b&gt;&lt;br&gt;(FastAPI · Python 3.12)&lt;br&gt;&lt;font color=&quot;#5A6C7D&quot;&gt;POST /api/v1/los/process&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#2E5E9E;fontSize=11;fontColor=#12304F;" vertex="1" parent="1">
          <mxGeometry x="70" y="372" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="orch" value="&lt;b&gt;Orchestration Layer&lt;/b&gt;&lt;br&gt;(LangGraph StateGraph)&lt;br&gt;&lt;font color=&quot;#5A6C7D&quot;&gt;workflow state machine&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C9DCF2;strokeColor=#204B82;fontSize=12;fontColor=#0F2A47;" vertex="1" parent="1">
          <mxGeometry x="400" y="372" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="orchresp" value="&lt;b&gt;The orchestrator:&lt;/b&gt;&amp;nbsp; identifies request type and LOS stage&amp;nbsp; ·&amp;nbsp; selects the agents the stage requires&amp;nbsp; ·&amp;nbsp; executes them and manages dependencies&amp;nbsp; ·&amp;nbsp; maintains workflow state&amp;nbsp; ·&lt;br&gt;handles retries, timeouts and circuit breaking&amp;nbsp; ·&amp;nbsp; routes failures&amp;nbsp; ·&amp;nbsp; invokes human review when confidence or policy requires it&amp;nbsp; ·&amp;nbsp; aggregates agent outputs." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6F82;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="760" y="372" width="800" height="52" as="geometry" />
        </mxCell>
        <mxCell id="orchnote" value="&lt;b&gt;Boundary:&lt;/b&gt; the orchestrator routes and sequences. It holds &lt;b&gt;no business rules&lt;/b&gt; — those live in the agents and deterministic services." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D9BE5E;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#4A4020;" vertex="1" parent="1">
          <mxGeometry x="760" y="430" width="800" height="22" as="geometry" />
        </mxCell>
        <mxCell id="broker1" value="&lt;b&gt;Message Broker&lt;/b&gt;&lt;br&gt;(RabbitMQ)&lt;br&gt;&lt;font color=&quot;#5A6C7D&quot;&gt;async &amp; long-running tasks&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E9F8;strokeColor=#7A3FA8;fontSize=11;fontColor=#3F1B57;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1590" y="372" width="310" height="80" as="geometry" />
        </mxCell>

        <!-- ================= BAND 4 : AGENTS ================= -->
        <mxCell id="a1" value="&lt;b&gt;Applicant Agent&lt;/b&gt;&lt;br&gt;Applicant &amp; case creation, information capture, document checklist, basic document status&lt;br&gt;&lt;i&gt;Stage: FOS&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="70" y="545" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;Document Intake Agent&lt;/b&gt;&lt;br&gt;Receives uploads, classifies document type, routes to the document pipeline&lt;br&gt;&lt;i&gt;Stage: FOS / Document Intake&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="536" y="545" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;Document Verification Agent&lt;/b&gt;&lt;br&gt;Authenticity, image quality, structural validation; emits score, confidence &amp; reason codes&lt;br&gt;&lt;i&gt;Stage: FOS / Verification&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="1002" y="545" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;KYC Agent&lt;/b&gt;&lt;br&gt;Cross-document identity consistency — name, DOB, PAN, father's name, address&lt;br&gt;&lt;i&gt;Stage: KYC&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="1468" y="545" width="430" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="&lt;b&gt;Eligibility Agent&lt;/b&gt;&lt;br&gt;Product &amp; applicant eligibility rules — age, income, configured conditions&lt;br&gt;&lt;i&gt;Stage: Eligibility&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="70" y="623" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;FOIR Agent&lt;/b&gt;&lt;br&gt;Computes FOIR (obligations ÷ income) &lt;b&gt;deterministically&lt;/b&gt;; compares to configured policy band&lt;br&gt;&lt;i&gt;Stage: Eligibility / Credit&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="536" y="623" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="&lt;b&gt;LTV Agent&lt;/b&gt;&lt;br&gt;Computes LTV (loan ÷ collateral value) &lt;b&gt;deterministically&lt;/b&gt;; compares to configured policy band&lt;br&gt;&lt;i&gt;Stage: Credit / Collateral&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="1002" y="623" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="&lt;b&gt;Income Assessment Agent&lt;/b&gt;&lt;br&gt;Salary and income analysis from verified evidence only&lt;br&gt;&lt;i&gt;Stage: Credit&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="1468" y="623" width="430" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a9" value="&lt;b&gt;Bank Statement Agent&lt;/b&gt;&lt;br&gt;Transaction extraction, balance reconciliation, banking behaviour signals&lt;br&gt;&lt;i&gt;Stage: Credit&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="70" y="701" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="&lt;b&gt;ITR Agent&lt;/b&gt;&lt;br&gt;ITR detection, extraction, acknowledgement &amp; PAN validation&lt;br&gt;&lt;i&gt;Stage: Credit / Income&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="536" y="701" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="&lt;b&gt;Fraud / Risk Agent&lt;/b&gt;&lt;br&gt;Fraud indicators and risk signals from documents, behaviour and device data&lt;br&gt;&lt;i&gt;Stage: Risk / Fraud&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="1002" y="701" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="&lt;b&gt;RCU Agent&lt;/b&gt;&lt;br&gt;Risk Containment Unit sampling — document, customer and property checks&lt;br&gt;&lt;i&gt;Stage: RCU&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="1468" y="701" width="430" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a13" value="&lt;b&gt;Collateral / Property Agent&lt;/b&gt;&lt;br&gt;Property and collateral verification; valuation inputs for LTV&lt;br&gt;&lt;i&gt;Stage: Collateral / RCU&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="70" y="779" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a14" value="&lt;b&gt;Credit Assessment Agent&lt;/b&gt;&lt;br&gt;Combines eligible financial &amp; credit evidence into one credit view&lt;br&gt;&lt;i&gt;Stage: Credit&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F0FB;strokeColor=#3667A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="536" y="779" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a15" value="&lt;b&gt;Decision Agent&lt;/b&gt;&lt;br&gt;Consolidates approved upstream outputs; drives the maker / checker workflow&lt;br&gt;&lt;i&gt;Stage: Decision&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DDEBD8;strokeColor=#3D7A3D;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="1002" y="779" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a16" value="&lt;b&gt;Human Review Agent&lt;/b&gt; (human-in-the-loop)&lt;br&gt;Routes to a person when confidence, policy or an exception requires it&lt;br&gt;&lt;i&gt;Stage: Review&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCE8D5;strokeColor=#B5701F;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="1468" y="779" width="430" height="70" as="geometry" />
        </mxCell>

        <!-- ================= BAND 5 : MCP / DEEP AGENT / LLM ================= -->
        <mxCell id="mcpbox" value="&lt;b&gt;MCP Layer&lt;/b&gt; (Model Context Protocol) — the &lt;b&gt;only&lt;/b&gt; path from an agent to a database, service or external system" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF6EE;strokeColor=#2F7D4F;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=11;fontStyle=1;fontColor=#1B3D28;" vertex="1" parent="1">
          <mxGeometry x="70" y="926" width="1120" height="125" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Document MCP" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F7D4F;fontSize=10;fontColor=#1B3D28;" vertex="1" parent="1">
          <mxGeometry x="85" y="952" width="210" height="32" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Applicant MCP" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F7D4F;fontSize=10;fontColor=#1B3D28;" vertex="1" parent="1">
          <mxGeometry x="305" y="952" width="210" height="32" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="KYC MCP" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F7D4F;fontSize=10;fontColor=#1B3D28;" vertex="1" parent="1">
          <mxGeometry x="525" y="952" width="210" height="32" as="geometry" />
