        <!-- ================= TITLE ================= -->
        <mxCell id="title" value="&lt;b&gt;Loan Origination System (LOS) — Agentic AI Production Architecture&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="End-to-end request flow: channel → security → orchestration → agents → MCP tools → data &amp; knowledge → decision → LOS. Deterministic rules decide; the LLM explains." style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=13;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="1440" y="22" width="1030" height="32" as="geometry" />
        </mxCell>

