  <diagram id="los-agentic-ai-production" name="LOS Agentic AI — Production Architecture">
    <mxGraphModel dx="2520" dy="2150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2520" pageHeight="2150" math="0" shadow="0">
      <root>
