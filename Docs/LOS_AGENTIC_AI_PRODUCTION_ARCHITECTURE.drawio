        <mxCell id="x7" value="&lt;b&gt;Decision Agent&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEBD8;strokeColor=#3D7A3D;fontSize=10;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="1294" y="1682" width="190" height="52" as="geometry" />
