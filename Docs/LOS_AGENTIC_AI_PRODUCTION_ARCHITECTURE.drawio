        <mxCell id="r5" value="&lt;b&gt;B · CASE KNOWLEDGE&lt;/b&gt;&lt;br&gt;case events · document metadata · verified facts · agent outputs · application state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6F82;fontSize=9;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="1025" y="1354" width="230" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="&lt;b&gt;Representation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#7B8FA3;fontSize=9;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1354" width="145" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ragnote" value="&lt;b&gt;Raw PDFs and images stay in Amazon S3.&lt;/b&gt; Only chunk text and its vector are stored in pgvector." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#8A2E2E;" vertex="1" parent="1">
          <mxGeometry x="1025" y="1406" width="860" height="24" as="geometry" />
        </mxCell>

