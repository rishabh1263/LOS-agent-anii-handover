          <mxGeometry x="1270" y="1300" width="145" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;Embedding Model&lt;/b&gt;&lt;br&gt;(BGE-M3 / Qwen Embeddings)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;fontSize=9;fontColor=#2A1A4A;" vertex="1" parent="1">
