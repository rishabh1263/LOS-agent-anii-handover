        <!-- ================= BAND 10 : FINAL RESPONSE ================= -->
        <mxCell id="f1" value="&lt;b&gt;Final LOS Decision&lt;/b&gt;&amp;nbsp; Approved · Rejected · Referred" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEBD8;strokeColor=#3D7A3D;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1">
