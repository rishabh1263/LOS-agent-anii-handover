        <mxCell id="x8" value="&lt;b&gt;Maker / Checker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6C7D&quot;&gt;two-person rule&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE8D5;strokeColor=#B5701F;fontSize=10;fontColor=#1F2D3D;" vertex="1" parent="1">
