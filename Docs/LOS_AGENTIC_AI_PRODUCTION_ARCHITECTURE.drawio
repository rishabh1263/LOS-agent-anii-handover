        <mxCell id="x5" value="Risk / Fraud" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#7B8FA3;fontSize=10;fontColor=#1F2D3D;" vertex="1" parent="1">
