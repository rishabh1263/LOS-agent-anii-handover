        </mxCell>
        <mxCell id="m6" value="Risk MCP" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F7D4F;fontSize=10;fontColor=#1B3D28;" vertex="1" parent="1">
