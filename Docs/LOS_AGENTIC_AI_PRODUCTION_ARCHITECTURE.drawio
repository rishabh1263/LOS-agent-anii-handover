        <!-- ================= BAND 7 : CHATBOT + RAG ================= -->
        <mxCell id="cbbox" value="&lt;b&gt;LOS AI Chatbot&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#7B8FA3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=11;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="70" y="1274" width="890" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cb1" value="&lt;b&gt;Query Router&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6C7D&quot;&gt;deterministic&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#2E5E9E;fontSize=10;fontColor=#12304F;" vertex="1" parent="1">
          <mxGeometry x="85" y="1302" width="160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="cb2" value="&lt;b&gt;CASE&lt;/b&gt; · &lt;b&gt;KNOWLEDGE&lt;/b&gt; · &lt;b&gt;MIXED&lt;/b&gt; · &lt;b&gt;STAGE&lt;/b&gt; · &lt;b&gt;DOWNSTREAM AGENT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6F82;fontSize=10;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="255" y="1302" width="270" height="46" as="geometry" />
        </mxCell>
        <mxCell id="cb3" value="&lt;b&gt;Grounding &amp; Validation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8A2E2E&quot;&gt;rejects unsupported claims&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#B3392B;fontSize=10;fontColor=#5A1810;" vertex="1" parent="1">
          <mxGeometry x="535" y="1302" width="200" height="46" as="geometry" />
        </mxCell>
        <mxCell id="cb4" value="&lt;b&gt;LLM phrasing&lt;/b&gt;&lt;br&gt;(Qwen / Ollama)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#B5701F;fontSize=10;fontColor=#4A3312;" vertex="1" parent="1">
          <mxGeometry x="745" y="1302" width="200" height="46" as="geometry" />
        </mxCell>
        <mxCell id="cb5" value="&lt;b&gt;Routing:&lt;/b&gt;&amp;nbsp; CASE → PostgreSQL case services&amp;nbsp; ·&amp;nbsp; KNOWLEDGE → RAG over Vector DB (pgvector)&amp;nbsp; ·&amp;nbsp; MIXED → structured case data &lt;b&gt;+&lt;/b&gt; RAG&amp;nbsp; ·&amp;nbsp; STAGE → workflow state&amp;nbsp; ·&amp;nbsp; AGENT → the authorised agent / MCP tool.&lt;br&gt;&lt;font color=&quot;#8A2E2E&quot;&gt;&lt;b&gt;The chatbot never invents&lt;/b&gt; applicant data, document status, eligibility, credit or risk decisions. Every answer is grounded in a retrieved fact or a stored record, or it is refused.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D9BE5E;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#4A4020;" vertex="1" parent="1">
          <mxGeometry x="85" y="1358" width="860" height="72" as="geometry" />
        </mxCell>

