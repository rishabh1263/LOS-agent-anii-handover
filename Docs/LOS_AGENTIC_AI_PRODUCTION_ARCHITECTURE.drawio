          <mxGeometry x="1702" y="1682" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="xnote" value="The Decision Agent consumes &lt;b&gt;structured outputs&lt;/b&gt; from upstream agents. &lt;font color=&quot;#8A2E2E&quot;&gt;&lt;b&gt;An LLM alone never makes the final lending decision.&lt;/b&gt;&lt;/font&gt; Every override is recorded with actor, reason and timestamp." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#33475B;" vertex="1" parent="1">
          <mxGeometry x="70" y="1738" width="1830" height="22" as="geometry" />
