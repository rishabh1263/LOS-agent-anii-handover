        </mxCell>
        <mxCell id="m7" value="RCU MCP" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F7D4F;fontSize=10;fontColor=#1B3D28;" vertex="1" parent="1">
          <mxGeometry x="305" y="990" width="210" height="32" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="Decision MCP" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F7D4F;fontSize=10;fontColor=#1B3D28;" vertex="1" parent="1">
          <mxGeometry x="525" y="990" width="210" height="32" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="Knowledge MCP" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F7D4F;fontSize=10;fontColor=#1B3D28;" vertex="1" parent="1">
          <mxGeometry x="745" y="990" width="210" height="32" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="Storage MCP" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F7D4F;fontSize=10;fontColor=#1B3D28;" vertex="1" parent="1">
          <mxGeometry x="965" y="990" width="210" height="32" as="geometry" />
        </mxCell>
        <mxCell id="mcpnote" value="Every tool enforces: &lt;b&gt;JSON schema&lt;/b&gt; · authentication · authorisation (scope + case &amp; party ownership) · timeout · retry budget · &lt;b&gt;audit entry&lt;/b&gt;.&amp;nbsp;&amp;nbsp; MCP is the &lt;b&gt;tool / contract&lt;/b&gt; layer — it is &lt;b&gt;not&lt;/b&gt; the workflow orchestrator." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#1B3D28;" vertex="1" parent="1">
          <mxGeometry x="85" y="1026" width="1090" height="20" as="geometry" />
        </mxCell>

        <mxCell id="deep" value="&lt;b&gt;Deep Agent Runtime&lt;/b&gt; (LangGraph Deep Agents)&lt;br&gt;&lt;br&gt;plan the task → select tools &lt;b&gt;via MCP&lt;/b&gt; → execute sub-tasks → gather evidence → synthesise a &lt;b&gt;structured&lt;/b&gt; result&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#8A2E2E&quot;&gt;&lt;b&gt;Cannot bypass&lt;/b&gt; authentication, MCP authorisation, deterministic rules or human approval gates. Assists the orchestrator; never replaces it.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#2A1A4A;" vertex="1" parent="1">
          <mxGeometry x="1210" y="926" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;LLM&lt;/b&gt; (Qwen 30B via Ollama)&lt;br&gt;&lt;br&gt;&lt;b&gt;Used for:&lt;/b&gt; reasoning, natural-language understanding, summarisation, chatbot phrasing, agent planning.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#8A2E2E&quot;&gt;&lt;b&gt;Never authoritative for:&lt;/b&gt; document authenticity · PAN / DOB validation · FOIR &amp; LTV arithmetic · eligibility hard rules · the final decision.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#B5701F;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#4A3312;" vertex="1" parent="1">
          <mxGeometry x="1570" y="926" width="330" height="125" as="geometry" />
        </mxCell>

