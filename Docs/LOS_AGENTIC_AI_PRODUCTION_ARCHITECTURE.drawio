        <mxCell id="u1" value="&lt;b&gt;FOS User&lt;/b&gt;&lt;br&gt;Field officer, on-site" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6F82;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1">
